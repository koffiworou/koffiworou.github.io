				}
			}
			@media screen and (max-width: 1230px) {
				#wrapper {
					scale: 1.1;
				}
			}
			@media screen and (max-width: 1120px) {
				#wrapper {
					scale: 1;
				}
			}
			@media screen and (max-width: 1024px) {
